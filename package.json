{
  "name": "collectorshub-pos",
  "private": true,
  "version": "0.1.10",
  "description": "Local-first CollectorsHub POS desktop app.",
  "author": "CollectorsHub",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "release": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "@vitejs/plugin-react": "^6.0.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.544.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^5.9.2",
    "vite": "^8.0.12"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.collectorshub.pos",
    "productName": "CollectorsHub POS",
    "directories": {
      "output": "release"
    },
    "artifactName": "CollectorsHub-POS-Setup-${version}.${ext}",
    "files": [
      "assets/**/*",
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Cymunix",
        "repo": "CollectorsHub_POS"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
